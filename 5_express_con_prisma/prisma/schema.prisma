// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  // @id > sirve para indicar que la columna es llave primaria
  // @default > indica cual sera su valor por defecto
  // @db > Sirve para indicar el tipo de dato en especifico que utilizaremos para la bd
  // Tipo_de_dato? > indicara que la columna puede aceptar valores nulos 
  // @map > sirve para indicar como se llamara esa propiedad en la base de datos, sino se le indica su valor sera igual que el nombre de la propiedad
  // @updateAt() Indica que esa columna obtendra el valor de la hora y fecha actual del servidor se realice un cambio en el registro

  id        Int     @id @default(autoincrement())
  email     String  @db.Text
  nombre    String?
  nickName  String  @map("nick_name")

  // Columna de auditoria
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt() @map("updated_at") 

  notas Nota[] // []> sirve para indicar que un registro podra contener varios registros con otra tabla

  // Para configuraciones de la tabla se usa dos @@
  @@map("usuarios")

}

model Nota {
  id          Int         @id @default(autoincrement())
  titulo      String  
  descripcion String?
  estado      EstadoNota  @default(POR_HACER)
  deletedAt   DateTime?   @map("deleted_at")

  // Relaciones
  usuarioId   Int     @map("usuario_id")
  usuario     Usuario @relation(fields: [usuarioId], references: [id])

  @@map("notas")
}

enum EstadoNota {
  POR_HACER
  HACIENDO
  REALIZADO
}
